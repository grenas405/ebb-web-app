{
  "name": "esmeraldas-bail-bonds",
  "version": "1.1.1",
  "exports": "./main.ts",
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-read --allow-env --unstable-kv main.ts",
    "start": "deno run --allow-net --allow-read --allow-env --unstable-kv main.ts",
    "check": "deno check main.ts && deno lint && deno fmt --check"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
